---
import { Image } from 'astro:assets';
import kursusImg from '../assets/1kursus.png';
import kajianImg from '../assets/2kajian.png';
import bimbinganImg from '../assets/3bimbingan.png';

const programs = [
  {
    title: 'Kursus Online',
    description: 'Belajar Disiplin Ilmu Islam Secara Privat dan Intensif',
    image: kursusImg,
  },
  {
    title: 'Kajian & Bimbingan Islam',
    description: 'Memahami Islam Secara Komperhensif dan Utuh',
    image: kajianImg,
  },
  {
    title: 'Bimbingan Pra-nikah',
    description: 'Tips & Trik Membangun Keluarga Sakinah, Mawadah dan Rahmah',
    image: bimbinganImg,
  },
]
---
<section class="py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl lg:text-center">
      <h2 class="text-base font-semibold leading-7 text-blue-600">
        Program yang Tersedia
      </h2>
      <p class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
        Pilih Program yang Tersedia untuk kebutuhan Anda
      </p>
    </div>

    <div class="mx-auto mt-16 max-w-7xl sm:mt-20 lg:mt-24">
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
            {programs.map(program => (
                <div class="flex flex-col overflow-hidden rounded-lg shadow-lg" id={program.title === 'Kajian & Bimbingan Islam' ? 'rekaman-kajian' : ''}>
                    <div class="flex-shrink-0 aspect-[13/8] w-full overflow-hidden">
                        <Image 
                          src={program.image} 
                          alt={program.title} 
                          class="h-full w-full object-cover" 
                        />
                    </div>
                    <div class="flex flex-1 flex-col justify-between bg-white p-6">
                        <div class="flex-1">
                            <p class="text-xl font-semibold text-gray-900">{program.title}</p>
                            <p class="mt-3 text-base text-gray-500">{program.description}</p>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>
  </div>
</section>