---
import { Image } from 'astro:assets';
import kursusImg from '../assets/1kursus.png';
import kajianImg from '../assets/2kajian.png';
import bimbinganImg from '../assets/3bimbingan.png';

const programs = [
  {
    title: 'Kursus Online',
    description: 'Belajar Disiplin Ilmu Islam Secara Privat dan Intensif',
    image: kursusImg,
  },
  {
    title: 'Kajian & Bimbingan Islam',
    description: 'Memahami Islam Secara Komperhensif dan Utuh',
    image: kajianImg,
  },
  {
    title: 'Bimbingan Pra-nikah',
    description: 'Tips & Trik Membangun Keluarga Sakinah, Mawadah dan Rahmah',
    image: bimbinganImg,
  },
]
---
<section class="relative py-24 sm:py-32 overflow-hidden">
  <!-- Background Decorations -->
  <div class="absolute top-0 left-0 w-full h-full -z-10 opacity-30">
    <div class="absolute top-[10%] right-[-5%] w-[30%] h-[30%] bg-blue-100 rounded-full blur-[100px]"></div>
  </div>

  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="program-header text-center mb-16 sm:mb-24">
      <h2 class="text-sm font-bold tracking-[0.2em] text-blue-600 uppercase mb-4">
        Program yang Tersedia
      </h2>
      <p class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl">
        Pilih Program <span class="text-blue-600">Terbaik</span> Anda
      </p>
      <div class="mt-6 flex justify-center">
        <div class="h-1 w-20 bg-blue-600 rounded-full"></div>
      </div>
    </div>

    <div class="mx-auto mt-16 max-w-7xl sm:mt-20 lg:mt-24">
        <div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-3">
            {programs.map(program => (
                <div 
                  class="program-card group relative flex flex-col overflow-hidden rounded-3xl border border-gray-100 bg-white/60 backdrop-blur-xl shadow-sm transition-all duration-500 hover:shadow-2xl hover:-translate-y-2" 
                  id={program.title === 'Kajian & Bimbingan Islam' ? 'rekaman-kajian' : ''}
                >
                    <div class="flex-shrink-0 aspect-[14/9] w-full overflow-hidden">
                        <Image 
                          src={program.image} 
                          alt={program.title} 
                          class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110" 
                        />
                    </div>
                    <div class="flex flex-1 flex-col justify-between p-8">
                        <div class="flex-1">
                            <p class="text-2xl font-bold text-gray-900 group-hover:text-blue-600 transition-colors">{program.title}</p>
                            <p class="mt-4 text-lg leading-relaxed text-gray-600">{program.description}</p>
                        </div>
                        <div class="mt-8 flex items-center text-blue-600 font-semibold group/link">
                          Pelajari Selengkapnya
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 ml-2 transition-transform group-hover/link:translate-x-1">
                            <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
                          </svg>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Set initial state
  gsap.set('.program-header', { opacity: 0, y: 50 });
  gsap.set('.program-card', { opacity: 0, y: 60, scale: 0.95 });

  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: 'section',
      start: 'top 75%',
      toggleActions: 'play none none none',
    },
    defaults: { ease: 'expo.out', duration: 1.2 }
  });

  tl.to('.program-header', {
    y: 0,
    opacity: 1,
  })
  .to('.program-card', {
    y: 0,
    opacity: 1,
    scale: 1,
    stagger: 0.2,
  }, "-=0.8");
</script>