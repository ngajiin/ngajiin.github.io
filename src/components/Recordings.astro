---
const recordings = ['Fikih', 'Aqidah', 'Tajwid'];
---
<section id="rekaman-kajian" class="relative py-24 sm:py-32 overflow-hidden bg-gray-50/50">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="recordings-header text-center mb-16 sm:mb-24">
      <h2 class="text-sm font-bold tracking-[0.2em] text-blue-600 uppercase mb-4">Rekaman</h2>
      <p class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl">Akses Kajian <span class="text-blue-600">Kapan Saja</span></p>
      <div class="mt-6 flex justify-center">
        <div class="h-1 w-20 bg-blue-600 rounded-full"></div>
      </div>
      <p class="mt-8 text-lg text-gray-600 max-w-2xl mx-auto">
        Tidak sempat mengikuti kelas langsung? Kami menyediakan rekaman kajian eksklusif yang bisa Anda akses kapan saja.
      </p>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-6">
      {recordings.map(rec => (
        <div class="recording-tag group relative px-8 py-4 rounded-2xl bg-white border border-gray-100 shadow-sm transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center text-blue-600 group-hover:bg-blue-600 group-hover:text-white transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
                <path fill-rule="evenodd" d="M4.5 5.653c0-1.426 1.529-2.33 2.779-1.643l11.54 6.348c1.295.712 1.295 2.573 0 3.285L7.28 19.991c-1.25.687-2.779-.217-2.779-1.643V5.653z" clip-rule="evenodd" />
              </svg>
            </div>
            <span class="text-xl font-bold text-gray-900">{rec}</span>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-16 text-center">
      <a 
        href="https://wa.me/+6281334225986/?text=Assalamu%27alaikum%20wr.%20wb.%0ASaya%20ingin%20mengakses%20rekaman%20kajian%20di%20Ngajiin.id." 
        class="inline-flex items-center rounded-full bg-blue-600 px-8 py-4 text-lg font-bold text-white shadow-lg hover:bg-blue-700 transition-all hover:scale-105 active:scale-95"
      >
        Akses Sekarang
      </a>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  gsap.set('.recordings-header', { opacity: 0, y: 30 });
  gsap.set('.recording-tag', { opacity: 0, scale: 0.9, y: 20 });

  gsap.to('.recordings-header', {
    scrollTrigger: {
      trigger: '.recordings-header',
      start: 'top 85%',
    },
    opacity: 1,
    y: 0,
    duration: 1
  });

  gsap.to('.recording-tag', {
    scrollTrigger: {
      trigger: '.recording-tag',
      start: 'top 90%',
    },
    opacity: 1,
    scale: 1,
    y: 0,
    duration: 0.6,
    stagger: 0.1,
    ease: "back.out(1.7)"
  });
</script>
