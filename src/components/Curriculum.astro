---
const programs = [
  {
    category: 'Fikih',
    levels: [
      { name: 'Pemula', book: 'Kitab Safinatunnajah' },
      { name: 'Mampu', book: 'Kitab Fathu al-Qarib' },
      { name: 'Cakap', book: 'Kitab Minhaj al-Talibin' },
    ],
  },
  {
    category: 'Aqidah',
    levels: [
      { name: 'Pemula', book: 'Kitab Aqidat al-Awam' },
      { name: 'Mampu', book: 'Kitab Maqalat al-Islamiyyin' },
      { name: 'Cakap', book: 'Kitab Al-qawl al-Sadid' },
    ],
  },
  {
    category: 'Tajwid',
    levels: [],
  },
];
---
<section class="relative py-24 sm:py-32 bg-gray-50/50">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="curriculum-header text-center mb-16">
      <h2 class="text-sm font-bold tracking-[0.2em] text-blue-600 uppercase mb-4">Kurikulum</h2>
      <p class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl">Materi Pembelajaran</p>
      <div class="mt-6 flex justify-center">
        <div class="h-1 w-20 bg-blue-600 rounded-full"></div>
      </div>
    </div>

    <div class="mx-auto grid max-w-2xl grid-cols-1 gap-8 sm:grid-cols-2 lg:mx-0 lg:max-w-none lg:grid-cols-3">
      {programs.map(program => (
        <div class="curriculum-card group relative flex flex-col rounded-3xl border border-gray-100 bg-white p-8 transition-all duration-300 hover:shadow-xl">
          <div class="flex-grow">
            <h3 class="text-2xl font-bold text-gray-900 mb-6 flex items-center gap-3">
              <span class="w-2 h-8 bg-blue-600 rounded-full"></span>
              {program.category}
            </h3>
            <div class="flex flex-col text-base leading-7 text-gray-700">
              {program.levels.length > 0 ? (
                <ul class="space-y-4">
                  {program.levels.map(level => (
                    <li class="flex items-start group/item">
                      <div class="mt-1 flex-shrink-0 w-5 h-5 rounded-full bg-blue-50 flex items-center justify-center group-hover/item:bg-blue-600 transition-colors">
                        <svg class="h-3 w-3 text-blue-600 group-hover/item:text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                          <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.052-.143z" clip-rule="evenodd" />
                        </svg>
                      </div>
                      <p class="ml-3 text-gray-600 group-hover/item:text-gray-900 transition-colors">
                        <span class="font-bold text-gray-800">{level.name}:</span> {level.book}
                      </p>
                    </li>
                  ))}
                </ul>
              ) : (
                <div class="p-4 rounded-2xl bg-blue-50 border border-blue-100">
                  <p class="italic text-blue-700 text-sm">Program tajwid tersedia dalam bentuk rekaman eksklusif.</p>
                </div>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  gsap.set('.curriculum-header', { opacity: 0, y: 30 });
  gsap.set('.curriculum-card', { opacity: 0, y: 30 });

  ScrollTrigger.batch('.curriculum-card', {
    onEnter: batch => gsap.to(batch, { opacity: 1, y: 0, stagger: 0.15, overwrite: true }),
    start: 'top 85%'
  });

  gsap.to('.curriculum-header', {
    scrollTrigger: {
      trigger: '.curriculum-header',
      start: 'top 85%',
    },
    opacity: 1,
    y: 0,
    duration: 1
  });
</script>
