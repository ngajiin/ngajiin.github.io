---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import ustadzImage from '../assets/ustadz.png';
import ustadz2Image from '../assets/ustadz2.jpeg';

const teachers = [
  {
    name: "Ustadz Achmad Syauqi Hifni, Lc., M.Ag",
    image: ustadzImage,
    description: "Seorang alumni Universitas Al-Azhar Mesir yang mendapatkan beasiswa penuh dari pemerintah Mesir.",
    whatsapp: "https://wa.me/6281334225986"
  },
  {
    name: "Ahmad Faaza Hudzaifah, M.A.",
    image: ustadz2Image,
    description: "Alumni UIN Sunan Kalijaga Yogyakarta dan penghafal Al-Qur’an. Beliau mendalami kajian Al-Qur’an, tafsir, serta fiqh, dan aktif membersamai peserta belajar dalam kelas Fiqh Nikah, Tajwid, dan Tahfidz dengan pendekatan yang lembut, sistematis, dan berlandaskan dalil yang kuat.",
    whatsapp: "https://wa.me/6281334225986" // Assuming same contact for now
  }
];
---
<Layout 
  title="Pengajar Kami - Ngajiin.id" 
  description="Kenalan lebih dekat dengan para pengajar di Ngajiin.id, para ahli lulusan Al-Azhar Mesir dan UIN Sunan Kalijaga yang berpengalaman di bidangnya."
>
  <div class="relative isolate overflow-hidden bg-gray-900">
    <div class="mx-auto max-w-7xl px-6 py-24 sm:py-32 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl font-bold tracking-tight text-white sm:text-6xl">Pengajar Kami</h1>
        <p class="mt-6 text-lg leading-8 text-gray-300">
          Belajar langsung bersama para ahli di bidangnya.
        </p>
      </div>
    </div>
  </div>

  <div class="bg-white py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-4xl space-y-24">
        {teachers.map((teacher, index) => (
          <div class={`grid grid-cols-1 gap-y-16 lg:grid-cols-2 lg:gap-x-16 items-center ${index % 2 !== 0 ? 'lg:flex-row-reverse' : ''}`}>
            <div class={`flex items-center ${index % 2 !== 0 ? 'lg:order-last' : ''}`}>
              <div class="aspect-[3/4] w-full max-w-sm mx-auto">
                <Image src={teacher.image} alt={teacher.name} class="rounded-3xl h-full w-full object-cover shadow-2xl" />
              </div>
            </div>
            <div class="flex flex-col justify-center">
              <div class="text-center lg:text-left">
                <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">{teacher.name}</h2>
                <p class="mt-4 text-xl text-gray-600">
                  {teacher.description}
                </p>
                <div class="mt-8 flex items-center justify-center lg:justify-start gap-x-6">
                  <a href={teacher.whatsapp} target="_blank" rel="noopener noreferrer" class="inline-flex items-center rounded-md bg-green-600 px-4 py-2.5 text-sm font-semibold text-white shadow-lg hover:bg-green-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-600">
                    Hubungi via WhatsApp
                  </a>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout>
