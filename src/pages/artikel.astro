---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

import mandiImg from '../assets/artikel/mandi.webp';
import puasaImg from '../assets/artikel/puasa.webp';
import sholatImg from '../assets/artikel/sholat.webp';
import wudluImg from '../assets/artikel/wudlu.webp';
import zakatImg from '../assets/artikel/zakat.webp';

// Dummy data for articles
const articles = [
  {
    id: 1,
    title: 'Hukum-hukum Air: Hal yang Mewajibkan Mandi Besar',
    category: 'Safinat al-Najah',
    author: 'Ust. Achmad Syauqi Hifni, Lc., M.Ag',
    image: mandiImg,
    date: '21 Feb 2026',
    excerpt: 'Pembahasan mendalam mengenai jenis-jenis air yang dapat digunakan untuk bersuci dan rukun mandi besar...'
  },
  {
    id: 2,
    title: 'Syarat Wudhu: Hal yang Membatalkan Wudhu',
    category: 'Safinat al-Najah',
    author: 'Ust. Achmad Syauqi Hifni, Lc., M.Ag',
    image: wudluImg,
    date: '20 Feb 2026',
    excerpt: 'Mengenal batasan dan hal-hal yang sering dianggap sepele namun ternyata dapat membatalkan kesucian wudhu kita...'
  },
  {
    id: 3,
    title: 'Rukun Salat: Syarat Sahnya Salat',
    category: 'Safinat al-Najah',
    author: 'Ust. Achmad Syauqi Hifni, Lc., M.Ag',
    image: sholatImg,
    date: '19 Feb 2026',
    excerpt: 'Salat adalah tiang agama. Mari pelajari kembali rukun-rukun salat agar ibadah kita semakin sempurna sesuai syariat...'
  },
  {
    id: 4,
    title: 'Puasa Ramadhan: Niat dan Hal yang Membatalkan',
    category: 'Safinat al-Najah',
    author: 'Ust. Achmad Syauqi Hifni, Lc., M.Ag',
    image: puasaImg,
    date: '18 Feb 2026',
    excerpt: 'Menyambut bulan suci dengan ilmu. Ringkasan hukum puasa mulai dari niat hingga hal-hal yang membatalkannya...'
  },
  {
    id: 5,
    title: 'Zakat Fitrah: Ketentuannya dalam Islam',
    category: 'Safinat al-Najah',
    author: 'Ust. Achmad Syauqi Hifni, Lc., M.Ag',
    image: zakatImg,
    date: '17 Feb 2026',
    excerpt: 'Kewajiban setiap muslim di akhir Ramadhan. Berapa takarannya dan siapa saja yang berhak menerimanya?'
  },
];

const featuredArticle = articles[0];
const latestArticles = articles.slice(1);
const recommendedArticles = articles.slice(1, 3); // For the new grid
---

<Layout 
  title="Artikel & Kajian Islam - Ngajiin.id" 
  description="Baca artikel dan ringkasan kajian kitab turath mulai dari Fiqih, Aqidah, hingga Adab bersama Ustadz Achmad Syauqi Hifni, Lc., M.Ag."
>
  <main class="pt-24 pb-16 bg-gray-50 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        
        <!-- Left Section: Main Content -->
        <div class="lg:col-span-2 space-y-10">
          
          <!-- Featured Hero -->
          <div class="relative aspect-video lg:aspect-[16/9] w-full overflow-hidden rounded-2xl shadow-2xl group cursor-pointer bg-gray-200">
            <Image 
              src={featuredArticle.image} 
              alt={featuredArticle.title}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent"></div>
            
            <div class="absolute top-6 left-0 z-10">
                <div class="relative bg-[#0990fe] text-white px-6 py-2 rounded-r-lg font-bold text-xs uppercase tracking-widest shadow-xl">
                  {featuredArticle.category}
                  <div class="absolute top-full left-0 w-1.5 h-1.5 bg-[#077edb] [clip-path:polygon(100%_0,0_0,100%_100%)]"></div>
                </div>
            </div>

            <div class="absolute inset-0 flex flex-col items-center justify-center p-8 text-center text-white">
              <div class="max-w-2xl space-y-4">
                <h1 class="text-4xl md:text-6xl font-serif leading-tight drop-shadow-2xl">
                  {featuredArticle.title.includes(':') ? (
                    <>
                      <span class="block mb-2">{featuredArticle.title.split(':')[0]}</span>
                      <span class="block text-xl md:text-2xl font-sans font-light opacity-90 italic">
                        {featuredArticle.title.split(':')[1]}
                      </span>
                    </>
                  ) : (
                    featuredArticle.title
                  )}
                </h1>
                
                <div class="flex items-center justify-center gap-4 pt-4">
                  <div class="h-px w-8 bg-white/50"></div>
                  <p class="text-sm font-medium tracking-widest uppercase opacity-80">
                      {featuredArticle.author}
                  </p>
                  <div class="h-px w-8 bg-white/50"></div>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Category Quick Links -->
          <div class="grid grid-cols-3 gap-0 py-6 border-y border-gray-200 bg-white rounded-xl shadow-sm">
            <div class="text-center border-r border-gray-100 group cursor-pointer">
                <p class="text-[10px] font-black text-gray-400 uppercase tracking-[0.2em] mb-1">Kategori</p>
                <p class="text-xs font-bold text-gray-900 uppercase group-hover:text-[#0990fe] transition-colors">Fiqih Ibadah</p>
            </div>
            <div class="text-center border-r border-gray-100 group cursor-pointer">
                <p class="text-[10px] font-black text-gray-400 uppercase tracking-[0.2em] mb-1">Kategori</p>
                <p class="text-xs font-bold text-gray-900 uppercase group-hover:text-[#0990fe] transition-colors">Aqidah Dasar</p>
            </div>
            <div class="text-center group cursor-pointer">
                <p class="text-[10px] font-black text-gray-400 uppercase tracking-[0.2em] mb-1">Kategori</p>
                <p class="text-xs font-bold text-gray-900 uppercase group-hover:text-[#0990fe] transition-colors">Akhlak Mulia</p>
            </div>
          </div>

          <!-- NEW SECTION: Discovery Grid (Filling the empty space) -->
          <div class="space-y-8">
            <div class="flex items-center justify-between">
              <h2 class="text-xl font-black text-gray-900 uppercase tracking-widest">Kajian Pilihan</h2>
              <div class="h-[2px] flex-grow mx-6 bg-gray-100"></div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              {recommendedArticles.map((article) => (
                <div class="group cursor-pointer">
                  <div class="relative aspect-[16/10] overflow-hidden rounded-2xl mb-4 shadow-lg">
                    <Image 
                      src={article.image} 
                      alt={article.title}
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                  </div>
                  <div class="space-y-2">
                    <div class="flex items-center gap-3">
                      <span class="text-[10px] font-bold text-[#0990fe] uppercase tracking-wider">{article.category}</span>
                      <span class="w-1 h-1 rounded-full bg-gray-300"></span>
                      <span class="text-[10px] font-medium text-gray-400 uppercase tracking-wider">{article.date}</span>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 leading-tight group-hover:text-[#0990fe] transition-colors">
                      {article.title}
                    </h3>
                    <p class="text-sm text-gray-500 line-clamp-2 leading-relaxed">
                      {article.excerpt}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Right Section: Sidebar Artikel (Sticky) -->
        <aside class="space-y-8 lg:sticky lg:top-28 self-start">
          <div class="relative">
            <h2 class="text-lg font-black text-gray-900 uppercase tracking-[0.15em] mb-6 flex items-center gap-3">
              <span class="w-8 h-[2px] bg-[#0990fe]"></span>
              Artikel Terbaru
            </h2>
            
            <div class="space-y-6">
              {latestArticles.map((article) => (
                <div class="flex gap-4 group cursor-pointer">
                  <div class="relative w-24 h-24 flex-shrink-0 overflow-hidden rounded-xl shadow-lg shadow-blue-900/5">
                    <Image 
                      src={article.image} 
                      alt={article.title}
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                    />
                    <div class="absolute inset-0 bg-black/10 group-hover:bg-transparent transition-colors"></div>
                  </div>
                  <div class="flex flex-col justify-center space-y-2">
                    <h3 class="text-sm font-bold text-gray-800 line-clamp-2 group-hover:text-[#0990fe] transition-colors leading-snug uppercase tracking-tight">
                      {article.title}
                    </h3>
                    <div class="flex items-center gap-2">
                      <span class="w-4 h-[1px] bg-gray-300"></span>
                      <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">{article.date}</p>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Sidebar CTA / Newsletter -->
          <div class="bg-gradient-to-br from-[#0c1e33] to-[#0990fe] p-8 rounded-3xl shadow-2xl text-white relative overflow-hidden group">
            <div class="absolute -top-10 -right-10 w-32 h-32 bg-white/10 rounded-full blur-2xl group-hover:scale-150 transition-transform duration-700"></div>
            <h3 class="text-xl font-black uppercase tracking-wider mb-2 relative z-10 text-white">Grup Kajian</h3>
            <p class="text-xs text-white/70 mb-6 leading-relaxed relative z-10">Dapatkan notifikasi ringkasan kajian kitab turath langsung di WhatsApp Anda.</p>
            <button class="w-full bg-white text-[#0c1e33] font-black py-3 rounded-xl text-xs uppercase tracking-widest hover:bg-gray-100 transition-all shadow-xl relative z-10">
              Gabung Sekarang
            </button>
          </div>

          <!-- Popular Categories -->
          <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
            <h2 class="text-xs font-black uppercase tracking-[0.2em] mb-4 text-gray-400">Topik Populer</h2>
            <div class="flex flex-wrap gap-2">
                {['Fiqih', 'Aqidah', 'Adab', 'Tafsir', 'Hadits'].map((cat) => (
                  <span class="bg-gray-50 hover:bg-blue-50 hover:text-[#0990fe] border border-gray-100 px-4 py-1.5 rounded-full text-[10px] font-bold tracking-wider cursor-pointer transition-all">
                    {cat}
                  </span>
                ))}
            </div>
          </div>

          <!-- Kalam Hikmah Widget -->
          <div class="bg-blue-50/50 p-6 rounded-2xl border border-blue-100">
            <h2 class="text-[10px] font-black uppercase tracking-[0.2em] mb-4 text-[#0990fe]">Kalam Hikmah</h2>
            <blockquote class="text-sm font-serif italic text-gray-600 leading-relaxed">
              "Barangsiapa yang menempuh jalan untuk mencari ilmu, maka Allah akan memudahkan baginya jalan menuju surga."
            </blockquote>
            <p class="text-[10px] font-bold text-gray-400 mt-4 uppercase tracking-wider">— HR. Muslim</p>
          </div>
        </aside>
      </div>

      <!-- Footer Action -->
      <div class="mt-20 max-w-3xl mx-auto">
        <a href="#" class="group block relative overflow-hidden rounded-2xl shadow-xl">
          <div class="bg-white border border-gray-100 p-8 text-center transition-transform duration-500 group-hover:-translate-y-2">
              <p class="text-lg font-serif italic text-gray-500 mb-2">Ingin menggali lebih dalam?</p>
              <p class="text-sm font-black text-gray-900 uppercase tracking-[0.2em]">
                Baca Lebih Banyak Artikel <span class="text-[#0990fe] ml-2 inline-block transition-transform group-hover:translate-x-2">→</span>
              </p>
          </div>
          <div class="h-2 bg-[#0990fe] w-full"></div>
        </a>
      </div>

    </div>
  </main>
</Layout>

<style>
  /* Custom scrollbar if needed */
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
